NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Enable only after verified SMTP delivery, OTP templates, and manual linking.
NEXT_PUBLIC_ACCOUNT_RECOVERY_ENABLED=false
# Public site key only. Configure its matching SECRET in Supabase Auth, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
